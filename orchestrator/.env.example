# ===================================================
# Orchestrator Environment Configuration (template)
# ===================================================
# Copy this file to .env and fill in real values.
#   cp orchestrator/.env.example orchestrator/.env
#
# IMPORTANT: start the orchestrator from the orchestrator/ directory.
# `dotenv` resolves .env against process.cwd(), so running from the repo
# root silently loads nothing and every credential comes back undefined.
#
# .env is gitignored and must never be committed.

# ---------------------------------------------------
# Primary LLM Provider: Groq
# ---------------------------------------------------
# Free tier: https://console.groq.com/keys
# Note: the free tier allows ~8k input tokens/minute and 200k tokens/day.
# Keep AGENT_MAX_ITERATIONS modest and AGENT_FINDINGS low to stay in budget.
GROQ_API_KEY=
# NOTE: reasoning models (openai/gpt-oss-120b) fail on tool loops through this
# SDK -- it sends `reasoning_content`, which Groq's API rejects.
# qwen3.8-27b is a non-reasoning model and works.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------
# Backup LLM Provider
# ---------------------------------------------------
# Tried only after the primary gives up. A backup that cannot answer makes
# every primary failure more expensive, so only configure one you can use.
# Set to one of: gemini | anthropic
BACKUP_LLM_PROVIDER=gemini

# Gemini (default backup). Used by BOTH the scan reviewer and the exploit
# verifier. Note: Gemini's safety filter tends to block prompts about
# injection vulnerabilities, so it may be unusable for the exploit phase.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic (alternative backup, if BACKUP_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_BASE_URL=https://api.anthropic.com

# ---------------------------------------------------
# LLM Fallback Behavior
# ---------------------------------------------------
# 0 = one attempt per provider, then fall back immediately. Recommended:
# retrying a rate-limited provider still bills tokens, so a retry loop burns
# the daily budget without doing any of the work.
LLM_MAX_RETRIES=0
LLM_FALLBACK_ON_STATUS_CODES=429,503
LLM_FALLBACK_ON_CONTENT_FILTER=true

# ---------------------------------------------------
# General App Configuration
# ---------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---------------------------------------------------
# PatchProof workspace (scan reports, exploits, diffs)
# ---------------------------------------------------
PATCHPROOF_WORKSPACE=.patchproof

# ---------------------------------------------------
# Target application under test
# ---------------------------------------------------
# Relative to the orchestrator/ directory.
TARGET_APP_PATH=../targets/vulnerable-shop

# The target's URL as seen from INSIDE the sandbox. The orchestrator runs
# exploits with `docker run`, so this is the in-container address, not a host one.
TARGET_BASE_URL=http://localhost:3000
TARGET_SOURCE_GLOB=src/**/*.js

# Port the app listens on inside the container.
TARGET_PORT=3000
TARGET_START_COMMAND=node src/server.js

# ---------------------------------------------------
# GitHub (optional)
# ---------------------------------------------------
# Token with `repo` scope. Without it, approvals fall back to applying the fix
# locally instead of opening a pull request.
GITHUB_TOKEN=

# "owner/name" the pull requests are opened against, e.g. acme/shop.
# This is only the DEFAULT: the dashboard has a field that overrides it at
# runtime (no need to edit this file). Overrides are in-memory and are lost
# on restart, which is the safer default.
GITHUB_DEFAULT_REPO=

# ---------------------------------------------------
# Agent runtime
# ---------------------------------------------------
# Loop budget per agent run. Keep at 12: the prescribed exploit flow
# (recon -> write_test_script -> run_in_sandbox) does not fit in fewer.
AGENT_MAX_ITERATIONS=12
AGENT_PROVIDER_TIMEOUT_MS=120000

# How many findings are processed at once. 1 = strictly sequential.
# Parallel agents multiply the request rate and are what provoked rate limiting.
AGENT_CONCURRENCY=1
# Minimum pause between agent requests, in milliseconds.
AGENT_THROTTLE_MS=2000

# ---------------------------------------------------
# Docker sandbox
# ---------------------------------------------------
# The image MUST be built first:  npm run sandbox:build
SANDBOX_IMAGE=patchproof-sandbox:latest
SANDBOX_CONTAINER_NAME=patchproof-sandbox

# `none` gives the container loopback only: it can reach the target running
# inside it, but has no route to the internet.
SANDBOX_NETWORK=none

# The target is NOT baked into the image; it arrives via this volume mount.
SANDBOX_MOUNT_PATH=/workspace/target
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256

# Per-command wall clock limit, and how long to wait for the target to boot.
SANDBOX_TIMEOUT_MS=60000
SANDBOX_READY_TIMEOUT_SEC=60
